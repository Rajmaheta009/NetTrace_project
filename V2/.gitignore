# ==============================================================================
# NetTrace AI v2.0 - Root .gitignore
# Prevents node_modules, virtualenvs, API keys, caches, and logs from being committed
# ==============================================================================

# 1. Environment & API Secrets (CRITICAL FOR SECURITY)
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# 2. Dependencies & Node.js
node_modules/
*/node_modules/
package-lock.json.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# 3. Frontend Production Build Artifacts
dist/
*/dist/
.vite/
*/.vite/

# 4. Python Virtual Environments & Packages
.venv/
*/.venv/
venv/
*/venv/
env/
*/env/
ENV/
*.egg-info/
.installed.cfg
*.egg

# 5. Python Bytecode & Caches
__pycache__/
*/__pycache__/
*.py[cod]
*.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# 6. NTFS Junction Links (Avoid Recursive Traversal in Git)
V2/frontend

# 7. Runtime Audit Logs & Temporary Files
logs/
*/logs/
*.log
tmp/
temp/

# 8. OS System & IDE Cache Files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*.suo
*.user

# 9. Large Backup Archives
*.zip
*.tar.gz
