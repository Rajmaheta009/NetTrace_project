# ==============================================================
# NetTrace Enterprise Forensic Intelligence Platform Configuration
# ==============================================================

# Database Configuration (PostgreSQL 16 Primary)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/nettrace
# For Docker Compose deployments:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/nettrace

# Cryptographic Token Security
JWT_SECRET=replace_with_a_secure_cryptographic_random_string_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# Large Language Model (Groq / Forensic Narrative Summarization)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_TIMEOUT_SECONDS=30

# Deterministic Pattern & Graph Analytics Parameters
BROKER_BETWEENNESS_PERCENTILE=0.80
DENSE_SUBGROUP_MIN_SIZE=3
DENSE_SUBGROUP_DENSITY_THRESHOLD=0.6
REPEATED_COOCCURRENCE_MIN_EVENTS=2

# Network Security & Cross-Origin Resource Sharing
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000,http://127.0.0.1:5173
